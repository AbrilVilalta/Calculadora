<Window x:Class="Calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculadora"
        mc:Ignorable="d"
        Title="Calculadora" Height="525" Width="315" Background="Black">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#313336"
        BorderThickness="1"
        CornerRadius="15"
        Background="#313336"
        Margin="5"
        Grid.Row="0">

            <StackPanel HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="10">

                <TextBlock
                x:Name="operacioText"
                FontSize="18"
                Foreground="Gray"
                TextAlignment="Right"
                HorizontalAlignment="Stretch"
                TextWrapping="Wrap"
                Margin="0 0 5 0"/>

                <TextBox
                x:Name="in_out"
                Background="#313336"
                Foreground="White"
                BorderThickness="0"
                FontSize="50"
                TextAlignment="Right"
                CaretBrush="White"
                Text="0"
                TextWrapping="Wrap"
                TextChanged="in_out_TextChanged"
                Loaded="TextBox_Loaded"
                PreviewTextInput="TextBox_PreviewTextInput"
                PreviewKeyDown="TextBox_PreviewKeyDown"/>

            </StackPanel>
            
        </Border>
        
        <Grid Grid.Row="1" Margin="5 0 10 10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="#313336" BorderThickness="1" CornerRadius="10" Background="#313336" 
                    Grid.Column="3" Grid.Row="0" Grid.RowSpan="5"></Border>

            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="0" Grid.Row="0">
                <Button Style="{StaticResource ButtonsStyle}" Content="7" Tag="7" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="1" Grid.Row="0">
                <Button Style="{StaticResource ButtonsStyle}" Content="8" Tag="8" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="2" Grid.Row="0">
                <Button Style="{StaticResource ButtonsStyle}" Content="9" Tag="9" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="3" Grid.Row="0">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="/" Tag="/" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="0" Grid.Row="1">
                <Button Style="{StaticResource ButtonsStyle}" Content="4" Tag="4" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="1" Grid.Row="1">
                <Button Style="{StaticResource ButtonsStyle}" Content="5" Tag="5" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="2" Grid.Row="1">
                <Button Style="{StaticResource ButtonsStyle}" Content="6" Tag="6" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="3" Grid.Row="1">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="*" Tag="*" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="0" Grid.Row="2">
                <Button Style="{StaticResource ButtonsStyle}" Content="1" Tag="1" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="1" Grid.Row="2">
                <Button Style="{StaticResource ButtonsStyle}" Content="2" Tag="2" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="2" Grid.Row="2">
                <Button Style="{StaticResource ButtonsStyle}" Content="3" Tag="3" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="3" Grid.Row="2">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="-" Tag="-" Click="BotoClick" Focusable="False"></Button>
            </Border>

            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="0" Grid.Row="3">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="(" Tag="(" Click="BotoClick" Focusable="False"></Button>
            </Border>

            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="2" Grid.Row="3">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content=")" Tag=")" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="1" Grid.Row="4">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="√" Tag="√" Click="BotoClick" Focusable="False"></Button>
            </Border>

            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="3" Grid.Row="3">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="+" Tag="+" Click="BotoClick" Focusable="False"></Button>
            </Border>

            <Border Style="{StaticResource BorderButtonsStyle}" CornerRadius="10" Grid.Column="0" Grid.Row="4">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="C" Tag="C" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="1" Grid.Row="3">
                <Button Style="{StaticResource ButtonsStyle}" Content="0" Tag="0" Click="BotoClick" Focusable="False"></Button>
            </Border>
            
            <Button Style="{StaticResource EqualButtonStyle}" Background="#f79d65" Grid.Column="2" 
                    Grid.Row="4" Content="=" Click="IgualClick" Focusable="False"></Button>
            
            <Border Style="{StaticResource BorderButtonsStyle}" Grid.Column="3" Grid.Row="4">
                <Button Style="{StaticResource SpecialButtonsStyle}" Content="^" Tag="**" Click="BotoClick" Focusable="False"></Button>
            </Border>

        </Grid>
    </Grid>
</Window>
